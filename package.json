{
  "name": "puppeteer-crawler",
  "version": "0.3.0",
  "description": "支持断点续爬、增量更新和任务管理的小说采集工具",
  "private": true,
  "type": "module",
  "bin": {
    "crawler": "dist/cli/index.js"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "tsx src/cli/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "format": "prettier --write .",
    "check": "tsc --noEmit && npm test && npm run build && prettier --check ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ViewRoom/puppeteer-crawler.git"
  },
  "author": "ViewRoom",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/ViewRoom/puppeteer-crawler/issues"
  },
  "homepage": "https://github.com/ViewRoom/puppeteer-crawler#readme",
  "dependencies": {
    "@fastify/static": "^10.1.6",
    "commander": "^14.0.0",
    "fastify": "^5.12.7",
    "lucide-react": "^1.59.0",
    "pino": "^10.0.0",
    "puppeteer": "^25.14.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "prettier": "^3.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.4",
    "vitest": "^4.1.12"
  }
}
